# Local development only: copy to .env (never commit .env).
POSTGRES_USER=feedbrain
POSTGRES_DB=feedbrain
POSTGRES_PASSWORD=replace-with-a-local-development-password
API_PORT=8000
LOG_LEVEL=INFO


# Action Broker V1: explicit logical aliases to existing Feedbrain subscription IDs.
# Read available IDs via GET /subscriptions. No default source is authorized.
