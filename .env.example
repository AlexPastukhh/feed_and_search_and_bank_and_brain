# Local development only: copy to .env (never commit .env).
POSTGRES_USER=feedbrain
POSTGRES_DB=feedbrain
POSTGRES_PASSWORD=replace-with-a-local-development-password
API_PORT=8000
LOG_LEVEL=INFO


# Feedbrain adapter connection inside Docker; source selection is now in Action YAML.
# ACTION_FEEDBRAIN_URL=http://api:8000


# External AI completed-Run registration is OFF unless explicitly provisioned.
# Set privately on the trusted API host: JSON list [{"token":"strong-secret","action_ids":[3,4]}].
# Never commit credentials or expose this local API to untrusted networks.
# ACTION_EXTERNAL_RUN_TOKENS=

# Independent Gateway READ bearer verifier (lowercase SHA-256 hex only; never the raw token).
# ACTION_GATEWAY_READ_TOKEN_SHA256=
# Optional native HTTPS/443 service: enable only after owner network/TLS acceptance.
# This is the SHA-256 verifier only; the raw Bearer belongs exclusively in the Gateway vault.
# Create external Docker volume fortis-actioncore-gateway-tls with tls.crt and tls.key.
# The private key remains upstream and is mounted read-only into action-core-gw.
